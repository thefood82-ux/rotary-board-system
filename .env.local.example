# Supabase 접속 정보 견본 (실제 키 없음)
# 사용법: 이 파일을 .env.local 로 복사한 뒤, 실제 값을 채워 넣으세요.
# .env.local 자체는 Git에 올라가지 않습니다.

# --- 클라이언트(브라우저)에서 사용 — NEXT_PUBLIC_ 접두사 필수 ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (공개용 키. 브라우저에 노출되어도 되는 키만 여기에 넣습니다)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- 서버 전용 — NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요 ---
# Secret key: 서버(API Routes/서버 컴포넌트)에서만 사용하는 키입니다.
# 이 키가 노출되면 DB 전체 데이터를 우회 접근당할 수 있으므로
# 클라이언트 코드나 NEXT_PUBLIC_ 변수에 절대 넣지 마세요.
SUPABASE_SECRET_KEY=
